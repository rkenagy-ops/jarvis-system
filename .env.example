# Copy to .env and fill in. Never commit .env.

# --- Super Jarvis / SpaceXAI (required for the HUD) ---
# https://console.x.ai
XAI_API_KEY=
JARVIS_VOICE=orion
JARVIS_MODEL=grok-4.6
JARVIS_HOST=127.0.0.1
JARVIS_PORT=8787
JARVIS_OWNER_NAME=Rhett

# --- GitHub (this repo + your account) ---
# https://github.com/settings/tokens  scopes: repo, read:user
GITHUB_TOKEN=
GITHUB_USERNAME=rkenagy-ops

# --- Optional CrewAI / LiteLLM fallback ---
ANTHROPIC_API_KEY=
LITELLM_MASTER_KEY=
LITELLM_BASE_URL=http://localhost:4000
KIMI_K3_BASE_URL=

# --- Optional hosted memory ---
SUPABASE_URL=
SUPABASE_KEY=

# --- Optional support services (docker compose) ---
N8N_USER=
N8N_PASSWORD=
WHISPER_BASE_URL=http://localhost:9000
PIPER_BASE_URL=http://localhost:10200

# --- Markets / trading (paper is default) ---
TRADING_MODE=paper
TRADING_REQUIRE_CONFIRMATION=true
PAPER_CASH=100000
JARVIS_WATCHLIST=SPY,QQQ,AAPL,MSFT,NVDA,TSLA,BTC-USD
JARVIS_AUTONOMY=true
