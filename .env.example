# Copy to .env and fill in. Never commit .env.

# --- Super Jarvis / SpaceXAI (required for the HUD) ---
# https://console.x.ai
XAI_API_KEY=
JARVIS_VOICE=orion
JARVIS_MODEL=grok-4.6
JARVIS_HOST=127.0.0.1
JARVIS_PORT=8787
JARVIS_OWNER_NAME=Rhett

# --- GitHub (this repo + your account) ---
# https://github.com/settings/tokens  scopes: repo, read:user
GITHUB_TOKEN=
GITHUB_USERNAME=rkenagy-ops

# --- Optional CrewAI / LiteLLM fallback ---
ANTHROPIC_API_KEY=
LITELLM_MASTER_KEY=
LITELLM_BASE_URL=http://localhost:4000
KIMI_K3_BASE_URL=

# --- Obsidian (default vault is ./vault — open that folder in Obsidian) ---
# OBSIDIAN_VAULT=C:\Users\Rhett\Documents\JarvisVault
OBSIDIAN_API_URL=
OBSIDIAN_API_KEY=

# --- Optional hosted memory (not required; vault + SQLite replace it) ---
SUPABASE_URL=
SUPABASE_KEY=

# --- Optional support services (docker compose) ---
N8N_USER=
N8N_PASSWORD=
N8N_WEBHOOK_URL=
WHISPER_BASE_URL=http://localhost:9000
PIPER_BASE_URL=http://localhost:10200
STIRLING_URL=http://127.0.0.1:8080
JELLYFIN_URL=
JELLYFIN_API_KEY=
IMMICH_URL=
IMMICH_API_KEY=
POSTIZ_URL=
WORDPRESS_URL=
WORDPRESS_USER=
WORDPRESS_APP_PASSWORD=
X_BEARER_TOKEN=
AMAZON_MARKETPLACE=US

# --- Markets / trading (paper is default) ---
TRADING_MODE=paper
TRADING_REQUIRE_CONFIRMATION=true
PAPER_CASH=100000
JARVIS_WATCHLIST=SPY,QQQ,AAPL,MSFT,NVDA,TSLA,BTC-USD
JARVIS_AUTONOMY=true
