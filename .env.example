# Copy to .env and fill in. Never commit .env.

# --- Super Jarvis / SpaceXAI (required for the HUD) ---
# https://console.x.ai
XAI_API_KEY=
JARVIS_VOICE=eve
JARVIS_VOICE_MODEL=grok-voice-think-fast-2.0
JARVIS_MODEL=grok-4.6
JARVIS_HOST=127.0.0.1
JARVIS_PORT=8787
JARVIS_OWNER_NAME=Rhett
# Auto-written on first start. Do not share. HUD bootstraps it from loopback only.
JARVIS_TOKEN=
# Never set true unless you also set JARVIS_TOKEN and a firewall allowlist.
JARVIS_ALLOW_LAN=false
JARVIS_PUBLIC_HOST=
# true = skip xAI; use Ollama if up, else free APIs.
JARVIS_OFFLINE=false
# Local brain (loopback). Install from https://ollama.com then: ollama pull llama3.2
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.1:8b
OLLAMA_EMBED_MODEL=nomic-embed-text
# Microsoft personal calendar + mail (device login)
# Azure → App registration → public client flows ON
# Permissions: User.Read, Calendars.Read, Mail.Send, offline_access
MS_CLIENT_ID=
MS_TENANT=consumers
MS_REFRESH_TOKEN=

# --- GitHub (this repo + your account) ---
# https://github.com/settings/tokens  scopes: repo, read:user
GITHUB_TOKEN=
GITHUB_USERNAME=rkenagy-ops

# --- Optional CrewAI / LiteLLM fallback ---
ANTHROPIC_API_KEY=
LITELLM_MASTER_KEY=
LITELLM_BASE_URL=http://localhost:4000
KIMI_K3_BASE_URL=

# --- Obsidian (default vault is ./vault — open that folder in Obsidian) ---
# OBSIDIAN_VAULT=C:\Users\Rhett\Documents\JarvisVault
OBSIDIAN_API_URL=
OBSIDIAN_API_KEY=

# --- Optional hosted memory (not required; vault + SQLite replace it) ---
SUPABASE_URL=
SUPABASE_KEY=

# --- Optional support services (docker compose) ---
N8N_USER=
N8N_PASSWORD=
N8N_WEBHOOK_URL=
WHISPER_BASE_URL=http://localhost:9000
PIPER_BASE_URL=http://localhost:10200
STIRLING_URL=http://127.0.0.1:8080
JELLYFIN_URL=
JELLYFIN_API_KEY=
IMMICH_URL=
IMMICH_API_KEY=
POSTIZ_URL=
# Recommended live channel
WORDPRESS_URL=
WORDPRESS_USER=
WORDPRESS_APP_PASSWORD=
X_BEARER_TOKEN=
# User-context OAuth (required to tweet; bearer is usually read-only)
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_SECRET=
AMAZON_MARKETPLACE=US

# --- Markets / trading (paper is default) ---
TRADING_MODE=paper
TRADING_REQUIRE_CONFIRMATION=true
# Official Alpaca: https://app.alpaca.markets
ALPACA_KEY_ID=
ALPACA_SECRET_KEY=
# true = real cash. Still requires a confirm token. Default is Alpaca paper.
ALPACA_LIVE=false
# Official IBKR: TWS / IB Gateway on this PC only (loopback)
IBKR_PORT=7497
IBKR_CLIENT_ID=7
IBKR_LIVE=false
MARKETBEAST_ROOT=C:\Users\Rhett\jarvis-system\vendor\marketbeast\hypertrader
PAPER_CASH=100000
JARVIS_WATCHLIST=SPY,QQQ,AAPL,MSFT,NVDA,TSLA,BTC-USD
JARVIS_AUTONOMY=true

# --- Morning engagement run (app/engage.py) ---
# Auto-commenting works ONLY where the network has an official reply API.
#   X        -> official home timeline + reply. Uses the X_* OAuth1 keys above.
#   Threads  -> official. Scopes: threads_content_publish, threads_keyword_search
#   LinkedIn -> official but the Comments API needs restricted partner access
#   Instagram / Facebook -> Meta exposes NO endpoint for commenting on another
#     account's post, so these can only ever be drafted into a review queue.
#     IG_* / FB_* below are read-only (hashtag + page discovery).
THREADS_ACCESS_TOKEN=
THREADS_USER_ID=
LINKEDIN_ACCESS_TOKEN=
LINKEDIN_AUTHOR_URN=
IG_ACCESS_TOKEN=
IG_USER_ID=
FB_PAGE_TOKEN=
FB_PAGE_ID=
# Comma separated topics/hashtags used for Threads + Instagram discovery
ENGAGE_TOPICS=
# Voice the drafted comments are written in. Defaults to the owner name.
ENGAGE_VOICE=
# Posts per network per run (1-5) and a hard daily ceiling across all networks
ENGAGE_MAX_PER_NETWORK=3
ENGAGE_DAILY_CAP=15
# true = bot-21 posts without asking on the official networks
ENGAGE_AUTO=false
